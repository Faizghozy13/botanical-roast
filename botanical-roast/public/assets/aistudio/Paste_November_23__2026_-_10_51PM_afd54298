<script>
  // Interactive Tab Filter: Filter Categories & Search
  const filterButtons = document.querySelectorAll('#filter-container button');
  const sections = document.querySelectorAll('.menu-category-section');
  const searchInput = document.getElementById('menu-search');
  const allCards = document.querySelectorAll('.menu-item-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const selectedFilter = button.getAttribute('data-filter');

      // Update button classes
      filterButtons.forEach(btn => {
        btn.className = "px-space-lg py-2.5 rounded-full font-label-lg text-label-lg bg-surface-container-low text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-all duration-200 whitespace-nowrap";
      });
      button.className = "px-space-lg py-2.5 rounded-full font-label-lg text-label-lg bg-primary-container text-on-primary transition-all duration-200 shadow-sm active:scale-95 whitespace-nowrap";

      // Show/hide category sections
      sections.forEach(sec => {
        if (selectedFilter === 'all' || sec.getAttribute('data-category') === selectedFilter) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });
    });
  });

  // Simple live search filter
  searchInput.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase().trim();
    if (!term) {
      allCards.forEach(card => card.classList.remove('hidden'));
      return;
    }
    allCards.forEach(card => {
      const cardText = card.textContent.toLowerCase();
      if (cardText.includes(term)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });
</script>
